# Окружение и кэш
.venv/
__pycache__/
*.pyc

# Сгенерированные датасеты (воспроизводятся generate_dataset.py по seed)
output/
output_*/

# Результаты обучения: в репозитории только runs/train (графики, results.csv, best.pt);
# last.pt нужен лишь для возобновления, прогоны оценки (runs/val) локальные
runs/*
!runs/train/
runs/train/*/weights/last.pt

# Веса, артефакты GUI
/weights/
*.pt
!runs/train/*/weights/best.pt
/gui_outputs/
/backups/

# Логи и архивы
*.log
*.zip

# Курсовая: текст, презентация, образец
Курсовая_*.md
*.pptx
*.docx
